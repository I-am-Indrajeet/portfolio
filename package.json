{
  "name": "indrajeet-mahara-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "check:site": "node scripts/check-site.mjs",
    "predev": "node scripts/generate-seo.mjs",
    "prebuild": "node scripts/generate-seo.mjs",
    "format": "prettier --write src scripts tests *.js *.json *.html"
  },
  "dependencies": {
    "@tailwindcss/vite": "latest",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4"
  }
}
